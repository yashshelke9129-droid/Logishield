# LogiShield backend environment template.
# Copy to backend/.env for local development and fill in real
# values. NEVER commit backend/.env to git.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=logishield
DB_USER=postgres
DB_PASSWORD=change-me

# Optional: full PostgreSQL connection string. When set it is
# used instead of the individual DB_* variables.
# DATABASE_URL=

# SSL mode for the database driver:
# disable | allow | prefer | require
# Defaults to "disable" for localhost and "require" for any
# remote host (Render managed PostgreSQL needs SSL).
# DB_SSLMODE=require

# Comma separated list of extra allowed browser origins.
# The Vercel production origin and localhost dev origins are
# always allowed.
# CORS_ORIGINS=https://your-frontend.example.com
