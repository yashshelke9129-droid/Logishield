# LogiShield frontend environment template.
# Copy to .env.local for local development, or set these
# variables in Vercel (Project Settings -> Environment
# Variables) for production. NEVER put database credentials
# or backend secrets in NEXT_PUBLIC_* variables - they are
# embedded into the browser bundle.

# Base URL of the LogiShield FastAPI backend.
#
# Production (Vercel):
#   NEXT_PUBLIC_API_URL=https://logishield-api.onrender.com
#
# Local development (.env.local):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# If the variable is missing, production builds fail fast
# instead of silently calling http://127.0.0.1:8000. Only
# `next dev` falls back to the local API server.
NEXT_PUBLIC_API_URL=https://logishield-api.onrender.com
